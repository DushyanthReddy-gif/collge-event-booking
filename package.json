{
  "name": "college-event-booking-system",
  "version": "1.0.0",
  "private": true,
  "description": "College Event Booking & Management System - Next.js + PostgreSQL + Neo4j + pgvector",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:reset": "tsx scripts/db-setup.ts --reset",
    "db:embed": "tsx scripts/embed-events.ts",
    "neo4j:setup": "tsx scripts/neo4j-setup.ts",
    "setup": "npm run db:reset && npm run db:embed && npm run neo4j:setup",
    "test": "vitest run"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "neo4j-driver": "^5.27.0",
    "next": "^15.1.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
