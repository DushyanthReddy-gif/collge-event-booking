# Copy to .env  (cp .env.example .env). Never commit the real .env file.

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://ceb_user:ceb_password@localhost:5432/college_events

# Neo4j (matches docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ceb_neo4j_password

# Session signing key - generate your own:  openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Embeddings: "transformers" = local Xenova/all-MiniLM-L6-v2 (default, downloads ~25MB once)
#             "hash"         = offline lexical fallback (no download, used by CI/tests)
EMBEDDING_PROVIDER=transformers

# Used only by the automated tests
TEST_BASE_URL=http://localhost:3000
